{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "VITE_CLOUD_DEPLOYMENT=true npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "regions": ["hnd1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/app/**,models/yolo-catpain.onnx,models/*.tflite,models/kittycheck/**,models/*LICENSE*,models/yolo-model.json,models/localization-models.json}",
      "excludeFiles": "{.venv/**,frontend/**,backend/tests/**,outputs/**,work/**,data/**,models/*.pth,models/*.pt,models/catpain-rn18.onnx,models/cloud-model.json,.playwright-cli/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api(?:/|$)|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
